{
  "version": 4,
  "configurations": [
    {
      "name": "i686 freestanding kernel",
      "compilerPath": "/home/soumish/opt/cross/bin/i686-elf-gcc",
      "compilerArgs": [
        "-m32",
        "-ffreestanding",
        "-nostdlib",
        "-nostdinc",
        "-fno-builtin",
        "-std=gnu99"
      ],
      "intelliSenseMode": "gcc-x86",
      "cStandard": "c99",
      "includePath": [
        "${workspaceFolder}/src/**"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}/src"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ]
}